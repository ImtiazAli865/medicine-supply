# Copy to .env.local and fill in values from the Supabase dashboard (Project Settings -> API).
# Placeholders only. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Tests only (put these in .env.test.local, never in .env.local, and use a SEPARATE test project):
# SUPABASE_TEST_URL=https://your-test-project-ref.supabase.co
# SUPABASE_TEST_ANON_KEY=your-test-project-anon-key
# SUPABASE_TEST_SERVICE_ROLE_KEY=your-test-project-service-role-key

# Voice order entry (Module 008). Server only: never use a NEXT_PUBLIC_ name, never commit a real value.
# GEMINI_API_KEY is read in exactly one file (src/lib/voice/gemini.ts). Put your own paid-tier key in .env.local yourself.
GEMINI_API_KEY=
# The model name is configuration, never hardcoded in the code (for example the current flash model of your account).
GEMINI_MODEL=
# Normally empty (the real Google address is used). Tests point it at a local fake server; the code refuses to
# call the real host from the test environment.
GEMINI_API_BASE_URL=
